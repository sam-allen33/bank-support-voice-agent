# Copy this file to a new file named ".env" and fill in your real values.
# (Keep .env private — never share it or commit it anywhere.)

# Find/create your API key in the ElevenLabs dashboard:
#   click your profile (bottom-left) -> API Keys -> Create API Key
ELEVENLABS_API_KEY=your_api_key_here

# After you create your agent, copy its Agent ID from the agent's page.
AGENT_ID=your_agent_id_here
